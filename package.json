{
  "name": "www-klaushofrichter",
  "private": true,
  "description": "Personal homepage for Klaus Hofrichter, served at www.klaushofrichter.net by Express on Knative/k3s.",
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:scanner": "tsc -p tsconfig.scanner.json",
    "scanner": "tsx scanner/src/main.ts",
    "start": "node dist/server.js",
    "dev": "tsx --env-file=.env src/server.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "fake-scanner": "tsx --env-file=.env e2e/fakeScanner.ts"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "google-auth-library": "^11.0.2",
    "jsonwebtoken": "^9.0.3",
    "multicast-dns": "^7.2.5",
    "node-cron": "^4.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.5.1",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.0.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
