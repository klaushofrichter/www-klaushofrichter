{
  "name": "www-klaushofrichter",
  "private": true,
  "description": "Personal homepage for Klaus Hofrichter, served at www.klaushofrichter.net by Express on Knative/k3s.",
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:scanner": "tsc -p tsconfig.scanner.json",
    "scanner": "tsx scanner/src/main.ts",
    "start": "node dist/server.js",
    "dev": "tsx --env-file=.env src/server.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.check.json && tsc -p e2e/tsconfig.json",
    "test:e2e": "playwright test",
    "fake-scanner": "tsx --env-file=.env e2e/fakeScanner.ts"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "google-auth-library": "^11.3.3",
    "jsonwebtoken": "^9.0.3",
    "multicast-dns": "^7.2.5",
    "node-cron": "^4.6.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
