{
  "name": "www-klaushofrichter",
  "private": true,
  "description": "Personal homepage for Klaus Hofrichter, served at www.klaushofrichter.net by Express on Knative/k3s.",
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx --env-file=.env src/server.ts",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "cookie-parser": "^1.4.7",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.2",
    "google-auth-library": "^10.9.1",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.14.10",
    "@types/node-cron": "^3.0.11",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
