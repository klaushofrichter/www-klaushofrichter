{
  "compilerOptions": {
    "target": "ES2022",
    // nodenext, not node10: TypeScript 7 removed "moduleResolution": "node".
    // package.json has "type": "commonjs", so this still emits CJS - checked
    // by running the built dist, not just by compiling.
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["ES2022"],
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": ["src"]
}
