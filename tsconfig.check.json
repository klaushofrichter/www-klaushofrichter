{
  // Type-checks everything nothing else compiles before a deploy: the tests,
  // the e2e specs and fake scanner, and the scanner itself (whose own build
  // otherwise first runs on the self-hosted deploy runner). vitest and tsx
  // strip types without checking them. Never emits.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "types": ["node"]
  },
  "include": ["src", "scanner/src", "test", "e2e", "playwright.config.ts", "vitest.config.ts"]
}
