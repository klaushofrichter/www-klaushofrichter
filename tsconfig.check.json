{
  // Type-checks everything nothing else compiles before a deploy: the tests
  // and the scanner itself (whose own build otherwise first runs on the
  // self-hosted deploy runner). vitest and tsx strip types without checking
  // them. Never emits. The e2e specs and fake scanner are checked by
  // e2e/tsconfig.json, which adds the DOM types their in-page callbacks need
  // without letting server code use them.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "types": ["node"]
  },
  "include": ["src", "scanner/src", "test", "playwright.config.ts", "vitest.config.ts"]
}
